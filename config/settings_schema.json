[
  {
    "name": "theme_info",
    "theme_name": "De'Jour",
    "theme_version": "1.0.0",
    "theme_author": "De'Jour",
    "theme_documentation_url": "https://help.shopify.com/sv/manual/online-store/themes",
    "theme_support_url": "https://dejour.store/pages/contact"
  },
  {
    "name": "Logotyp & favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logotyp",
        "info": "Använd en ljus logotyp (SVG eller PNG med transparent bakgrund)."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 260,
        "step": 5,
        "unit": "px",
        "label": "Logotypens bredd",
        "default": 130
      },
      {
        "type": "text",
        "id": "wordmark",
        "label": "Ordmärke",
        "info": "Visas när ingen logotyp är vald, i laddningsskärmen och i sidfoten.",
        "default": "DE'JOUR"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Visas i 32 × 32 px."
      }
    ]
  },
  {
    "name": "Färger",
    "settings": [
      {
        "type": "paragraph",
        "content": "Varje sektion väljer ett färgschema. Guldet används för detaljer, avskiljare och knappar."
      },
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Bakgrund",
            "default": "#0A0A0A"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Bakgrundsgradient",
            "info": "Ersätter bakgrundsfärgen om den fylls i."
          },
          {
            "type": "color",
            "id": "surface",
            "label": "Yta (kort, fält, paneler)",
            "default": "#141414"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#EDEAE4"
          },
          {
            "type": "color",
            "id": "muted",
            "label": "Sekundär text",
            "default": "#8A8680"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent (champagneguld)",
            "default": "#C9A96E"
          },
          {
            "type": "color",
            "id": "accent_light",
            "label": "Guldglans (ljus ton)",
            "default": "#F3E5C3"
          },
          {
            "type": "color",
            "id": "on_accent",
            "label": "Text på guldknapp",
            "default": "#0A0A0A"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "accent",
          "icons": "text",
          "primary_button": "accent",
          "on_primary_button": "on_accent",
          "primary_button_border": "accent",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "accent"
        }
      },
      {
        "type": "header",
        "content": "Övrigt"
      },
      {
        "type": "color",
        "id": "color_error",
        "label": "Fel och varningar",
        "default": "#D98C7F"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Bekräftelser",
        "default": "#B7C9A0"
      }
    ]
  },
  {
    "name": "Typografi",
    "settings": [
      {
        "type": "header",
        "content": "Rubriker"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Typsnitt",
        "info": "Rekommenderat: Cormorant eller Playfair Display.",
        "default": "cormorant_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 140,
        "step": 5,
        "unit": "%",
        "label": "Storlek",
        "default": 100
      },
      {
        "type": "range",
        "id": "heading_tracking",
        "min": -6,
        "max": 6,
        "step": 1,
        "label": "Teckenavstånd (em/100)",
        "default": -2
      },
      {
        "type": "header",
        "content": "Brödtext"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Typsnitt",
        "info": "Rekommenderat: Inter.",
        "default": "inter_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Storlek",
        "default": 100
      },
      {
        "type": "header",
        "content": "Etiketter"
      },
      {
        "type": "range",
        "id": "label_tracking",
        "min": 10,
        "max": 40,
        "step": 2,
        "label": "Spärrning i versaletiketter (em/100)",
        "default": 28
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1100,
        "max": 2000,
        "step": 20,
        "unit": "px",
        "label": "Maxbredd för innehåll",
        "default": 1640
      },
      {
        "type": "range",
        "id": "page_gutter",
        "min": 16,
        "max": 80,
        "step": 4,
        "unit": "px",
        "label": "Sidmarginal på desktop",
        "default": 56
      }
    ]
  },
  {
    "name": "Effekter",
    "settings": [
      {
        "type": "paragraph",
        "content": "Tunga effekter stängs automatiskt av när besökaren har valt 'minska rörelse' och på svaga mobiler."
      },
      {
        "type": "checkbox",
        "id": "grain_enabled",
        "label": "Filmkorn över bakgrunden",
        "default": true
      },
      {
        "type": "range",
        "id": "grain_opacity",
        "min": 2,
        "max": 16,
        "step": 1,
        "unit": "%",
        "label": "Filmkornets styrka",
        "default": 7
      },
      {
        "type": "checkbox",
        "id": "loader_enabled",
        "label": "Laddningsskärm med logga vid första besöket",
        "info": "Visas bara på dator. Sänker sidhastigheten något (Lighthouse).",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "page_transitions",
        "label": "Mjuka sidövergångar",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "reveal_enabled",
        "label": "Element glider och tonar in vid scroll",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "gsap_enabled",
        "label": "Avancerade effekter (GSAP)",
        "info": "Parallax, horisontell scroll och bokstavsanimation. GSAP laddas från CDN först när sidan är klar.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "magnetic_buttons",
        "label": "Magnetiska knappar på desktop",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "shimmer_enabled",
        "label": "Guldglans på knappar och detaljer",
        "default": true
      }
    ]
  },
  {
    "name": "Drop",
    "settings": [
      {
        "type": "paragraph",
        "content": "Gemensam tidpunkt för droppet. Anges i svensk tid (Europe/Stockholm). Sektionen 'Drop-nedräkning' kan använda den här tiden eller en egen."
      },
      {
        "type": "checkbox",
        "id": "drop_enabled",
        "label": "Aktivera drop-läge",
        "default": true
      },
      {
        "type": "text",
        "id": "drop_date",
        "label": "Datum (ÅÅÅÅ-MM-DD)",
        "default": "2026-11-27"
      },
      {
        "type": "text",
        "id": "drop_time",
        "label": "Klockslag (TT:MM)",
        "default": "18:00"
      },
      {
        "type": "text",
        "id": "drop_product_tag",
        "label": "Produkttagg för drop-produkter",
        "info": "Produkter med den här taggen visas, men köpknappen ersätts av nedräkning och 'Påminn mig' fram till droppet.",
        "default": "drop"
      },
      {
        "type": "text",
        "id": "drop_customer_tag",
        "label": "Kundtagg för 'Påminn mig'",
        "default": "drop-svart"
      },
      {
        "type": "text",
        "id": "drop_live_label",
        "label": "Text när droppet är live",
        "default": "LIVE NU – Köp här"
      },
      {
        "type": "url",
        "id": "drop_live_link",
        "label": "Länk när droppet är live",
        "info": "Används av nedräkningar som inte ligger på en produktsida."
      }
    ]
  },
  {
    "name": "Arkiv & bevakning",
    "settings": [
      {
        "type": "text",
        "id": "archive_tag",
        "label": "Produkttagg för arkivet",
        "info": "Produkter med taggen får etiketten 'Tidigare drop' eller 'Slutsåld'. Skapa en automatisk kollektion med handtaget 'arkiv' och villkoret Produkttagg = arkiv.",
        "default": "arkiv"
      },
      {
        "type": "text",
        "id": "notify_tag_prefix",
        "label": "Kundtagg för 'Bevaka'",
        "info": "Kunden taggas med prefixet och produktens handtag, t.ex. bevaka-obsidian-black.",
        "default": "bevaka"
      },
      {
        "type": "paragraph",
        "content": "Släppdatum hämtas från produktens metafält custom.release_date (typ: datum). Saknas det används publiceringsdatumet."
      }
    ]
  },
  {
    "name": "Produktkort",
    "settings": [
      {
        "type": "select",
        "id": "card_ratio",
        "label": "Bildformat",
        "options": [
          {
            "value": "portrait",
            "label": "Stående (4:5)"
          },
          {
            "value": "tall",
            "label": "Högt (2:3)"
          },
          {
            "value": "square",
            "label": "Kvadrat (1:1)"
          }
        ],
        "default": "portrait"
      },
      {
        "type": "checkbox",
        "id": "card_secondary_image",
        "label": "Visa andra bilden vid hovring",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Visa varumärke",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_badges",
        "label": "Visa etiketter (Ny, Slutsåld, Drop)",
        "default": true
      }
    ]
  },
  {
    "name": "Varukorg",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Typ",
        "options": [
          {
            "value": "drawer",
            "label": "Utfällbar panel"
          },
          {
            "value": "page",
            "label": "Sida"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Gräns för fri frakt (kr)",
        "info": "Visar en framstegsmätare i varukorgen. 0 döljer den. Måste stämma med fraktinställningarna i Shopify.",
        "default": 499
      },
      {
        "type": "checkbox",
        "id": "cart_note_enabled",
        "label": "Visa meddelandefält",
        "default": false
      },
      {
        "type": "text",
        "id": "cart_trust_text",
        "label": "Trygghetstext under kassaknappen",
        "default": "Säker betalning · 14 dagars ångerrätt · PostNord"
      }
    ]
  },
  {
    "name": "Sök",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "label": "Visa sökförslag medan man skriver",
        "default": true
      }
    ]
  },
  {
    "name": "Sociala medier",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/[FYLL I]"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "info": "https://tiktok.com/@[FYLL I]"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "X (Twitter)"
      }
    ]
  },
  {
    "name": "Valuta",
    "settings": [
      {
        "type": "checkbox",
        "id": "currency_code_enabled",
        "label": "Visa valutakod (t.ex. 499 kr SEK)",
        "default": false
      }
    ]
  }
]
