{{ 'pages.css' | asset_url | stylesheet_tag }}
{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<article class="article dj-section color-{{ s.color_scheme }} pb-lg">
  <header class="collection-hero{% if article.image %} collection-hero--image{% endif %}">
    {%- if article.image -%}
      <div class="collection-hero__media" aria-hidden="true">
        <div class="parallax" data-gsap="parallax" data-speed="8">
          {{
            article.image
            | image_url: width: 2400
            | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: ''
          }}
        </div>
      </div>
    {%- endif -%}
    <div class="container--text collection-hero__inner">
      <p class="label label--accent label--line hero__fade">
        <a href="{{ blog.url }}">{{ blog.title | escape }}</a> · {% render 'format-date', date: article.published_at %}
      </p>
      <h1 class="article__title hero__fade" style="--d: .1s">{{ article.title | escape }}</h1>
      {%- if s.show_author -%}
        <p class="label hero__fade" style="--d: .2s">{{ article.author | escape }}</p>
      {%- endif -%}
    </div>
  </header>

  <div class="container--text">
    <div class="rte article__content" data-reveal>{{ article.content }}</div>

    {%- if article.tags.size > 0 -%}
      <ul class="active-filters article__tags" role="list">
        {%- for tag in article.tags -%}
          <li><a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="chip">{{ tag | escape }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <a href="{{ blog.url }}" class="link article__back">
      {%- render 'icon', name: 'arrow-left' -%}
      {{ 'blog.back' | t: title: blog.title }}
    </a>

    {%- if blog.comments_enabled? -%}
      <section class="article__comments" id="comments">
        {%- if article.comments_count > 0 -%}
          <h2 class="h3">{{ 'blog.comments' | t: count: article.comments_count }}</h2>
          {%- paginate article.comments by 10 -%}
            <ul class="article__comment-list" role="list">
              {%- for comment in article.comments -%}
                <li class="article__comment" id="{{ comment.id }}">
                  <div class="rte">{{ comment.content }}</div>
                  <p class="label">{{ comment.author | escape }} · {% render 'format-date', date: comment.created_at %}</p>
                </li>
              {%- endfor -%}
            </ul>
            {%- render 'paginate-links', paginate: paginate -%}
          {%- endpaginate -%}
        {%- endif -%}

        {%- form 'new_comment', article, class: 'article__comment-form' -%}
          <h2 class="h4">{{ 'blog.leave_comment' | t }}</h2>
          {%- if form.posted_successfully? -%}
            <p class="form-msg form-msg--success" role="status">
              {%- render 'icon', name: 'check' -%}
              <span>
                {%- if blog.moderated? -%}{{ 'blog.comment_moderated' | t }}{%- else -%}{{ 'blog.comment_posted' | t }}{%- endif -%}
              </span>
            </p>
          {%- elsif form.errors -%}
            <p class="form-msg form-msg--error" role="alert">
              {%- render 'icon', name: 'error' -%}
              <span>{{ form.errors | default_errors }}</span>
            </p>
          {%- endif -%}
          <div class="form-grid form-grid--2">
            <div class="field">
              <input class="field__input" id="CommentAuthor" type="text" name="comment[author]" value="{{ form.author }}" placeholder=" " required autocomplete="name">
              <label class="field__label" for="CommentAuthor">{{ 'contact.name' | t }} *</label>
            </div>
            <div class="field">
              <input class="field__input" id="CommentEmail" type="email" name="comment[email]" value="{{ form.email }}" placeholder=" " required autocomplete="email" spellcheck="false" autocapitalize="off">
              <label class="field__label" for="CommentEmail">{{ 'contact.email' | t }} *</label>
            </div>
            <div class="field form-grid__full">
              <textarea class="field__input" id="CommentBody" name="comment[body]" rows="5" placeholder=" " required>{{ form.body }}</textarea>
              <label class="field__label" for="CommentBody">{{ 'contact.message' | t }} *</label>
            </div>
          </div>
          <button type="submit" class="btn btn--outline">
            <span class="btn__label">{{ 'blog.post_comment' | t }}</span>
          </button>
        {%- endform -%}
      </section>
    {%- endif -%}
  </div>
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "Artikel",
  "class": "section-main-article",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Visa skribent",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
