{%- assign s = section.settings -%}
<section class="columns dj-section color-{{ s.color_scheme }} pt-{{ s.padding_top }} pb-{{ s.padding_bottom }}{% if s.border_top %} dj-section--bordered{% endif %}">
  <div class="container">
    {%- if s.eyebrow != blank or s.heading != blank or s.text != blank -%}
      <div class="section-head{% if s.center_heading %} section-head--center{% endif %}">
        {%- if s.eyebrow != blank -%}
          <p class="label label--accent label--line" data-reveal>{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 data-reveal style="--d: .08s">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="lead" data-reveal style="--d: .16s">{{ s.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul
      class="columns__grid columns__grid--{{ s.style }}"
      role="list"
      style="--cols: {{ s.columns }}"
    >
      {%- for block in section.blocks -%}
        <li class="columns__item" data-reveal style="--d: {{ forloop.index0 | times: 0.1 }}s" {{ block.shopify_attributes }}>
          {%- if s.style == 'numbers' -%}
            <span class="columns__num gold-text">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- elsif block.settings.image != blank -%}
            <span class="columns__img">
              {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 48, height: 48 }}
            </span>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="columns__icon">{% render 'icon', name: block.settings.icon %}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="columns__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="columns__text text-body">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.link_label != blank -%}
            <a href="{{ block.settings.link | default: routes.root_url }}" class="link">{{ block.settings.link_label | escape }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Kolumner / USP:er",
  "class": "section-columns",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etikett"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Rubrik"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "center_heading",
      "label": "Centrera rubriken",
      "default": false
