        {
          "value": "numbers",
          "label": "Nummer (01, 02 …)"
        }
      ],
      "default": "icons"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Kolumner på desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Linje ovanför",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Avstånd ovanför",
      "options": [
        { "value": "none", "label": "Inget" },
        { "value": "sm", "label": "Litet" },
        { "value": "md", "label": "Mellan" },
        { "value": "lg", "label": "Stort" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Avstånd nedanför",
      "options": [
        { "value": "none", "label": "Inget" },
        { "value": "sm", "label": "Litet" },
        { "value": "md", "label": "Mellan" },
        { "value": "lg", "label": "Stort" }
      ],
      "default": "md"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Kolumn",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ikon",
          "options": [
            { "value": "none", "label": "Ingen" },
            { "value": "slim", "label": "Slim" },
            { "value": "rfid", "label": "RFID-skydd" },
            { "value": "truck", "label": "Frakt" },
            { "value": "return", "label": "Retur" },
            { "value": "leather", "label": "Läder" },
            { "value": "needle", "label": "Sömmar" },
            { "value": "card", "label": "Kort" },
            { "value": "layers", "label": "Lager" },
            { "value": "shield", "label": "Sköld" },
            { "value": "lock", "label": "Lås" },
            { "value": "gift", "label": "Present" },
            { "value": "sparkle", "label": "Glans" },
            { "value": "clock", "label": "Klocka" },
            { "value": "pin", "label": "Plats" }
          ],
          "default": "slim"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Egen ikon (ersätter ikonen)"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Rubrik",
          "default": "Slim design"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Kort beskrivning.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Länktext"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Länk"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP:er",
      "settings": {
        "border_top": true,
        "padding_top": "sm",
        "padding_bottom": "sm"
      },
      "blocks": [
        {
          "type": "column",
          "settings": {
            "icon": "slim",
            "title": "Slim design",
            "text": "<p>[FYLL I] mm tunn. Försvinner i fickan.</p>"
          }
        },
        {
