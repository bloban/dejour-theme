        {
          "type": "column",
          "settings": {
            "icon": "none",
            "title": "Hållbarhet",
            "text": "<p>[FYLL I]</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "none",
            "title": "Tidlös design",
            "text": "<p>[FYLL I]</p>"
          }
