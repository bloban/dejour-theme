{{ 'pages.css' | asset_url | stylesheet_tag }}
{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section class="blog dj-section color-{{ s.color_scheme }} pb-lg">
  <header class="collection-hero">
    <div class="container collection-hero__inner">
      <p class="label label--accent label--line hero__fade">{{ s.eyebrow | escape }}</p>
      <h1 class="collection-hero__title hero__fade" style="--d: .1s">{{ blog.title | escape }}</h1>
    </div>
  </header>

  <div class="container">
    {%- paginate blog.articles by 9 -%}
      {%- if blog.articles.size > 0 -%}
        <ul class="grid blog__grid" role="list" style="--cols: 3; --cols-tablet: 2; --cols-mobile: 1">
          {%- for article in blog.articles -%}
            <li>
              <a href="{{ article.url }}" class="article-card" data-reveal style="--d: {{ forloop.index0 | modulo: 3 | times: 0.08 }}s">
                <span class="article-card__media media">
                  {%- if article.image -%}
                    {%- assign article_alt = article.image.alt | default: article.title -%}
                    {{
                      article.image
                      | image_url: width: 1200
                      | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: article_alt
                    }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
                  {%- endif -%}
                </span>
                <span class="label">{% render 'format-date', date: article.published_at %}</span>
                <span class="article-card__title">{{ article.title | escape }}</span>
                <span class="text-small text-muted">
                  {%- if article.excerpt != blank -%}
                    {{ article.excerpt | strip_html | truncatewords: 24 }}
                  {%- else -%}
                    {{ article.content | strip_html | truncatewords: 24 }}
                  {%- endif -%}
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
        {%- render 'paginate-links', paginate: paginate -%}
      {%- else -%}
        <p class="text-muted">{{ 'blog.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blogg",
  "class": "section-main-blog",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etikett",
      "default": "Journal"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
