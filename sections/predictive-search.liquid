{%- comment -%}
  Renderas via /search/suggest?section_id=predictive-search
{%- endcomment -%}
{%- if predictive_search.performed -%}
  {%- liquid
    assign r = predictive_search.resources
    assign side_count = r.queries.size | plus: r.collections.size | plus: r.pages.size | plus: r.articles.size
    assign total = side_count | plus: r.products.size
  -%}
  {%- if total > 0 -%}
    <div class="predictive">
      <div class="predictive__side">
        {%- if r.queries.size > 0 -%}
          <div class="predictive__group">
            <h3 class="label label--accent">{{ 'search.suggestions' | t }}</h3>
            <ul class="predictive__list" role="list">
              {%- for query in r.queries -%}
                <li>
                  <a href="{{ query.url }}" data-predictive-option>{{ query.styled_text }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if r.collections.size > 0 -%}
          <div class="predictive__group">
            <h3 class="label label--accent">{{ 'search.collections' | t }}</h3>
            <ul class="predictive__list" role="list">
              {%- for collection in r.collections -%}
                <li>
                  <a href="{{ collection.url }}" data-predictive-option>{{ collection.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if r.pages.size > 0 or r.articles.size > 0 -%}
          <div class="predictive__group">
            <h3 class="label label--accent">{{ 'search.pages' | t }}</h3>
            <ul class="predictive__list" role="list">
              {%- for page in r.pages -%}
                <li>
                  <a href="{{ page.url }}" data-predictive-option>{{ page.title | escape }}</a>
                </li>
              {%- endfor -%}
              {%- for article in r.articles -%}
                <li>
                  <a href="{{ article.url }}" data-predictive-option>{{ article.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>

      <div class="predictive__main">
        {%- if r.products.size > 0 -%}
          <h3 class="label label--accent">{{ 'search.products' | t }}</h3>
          <ul class="predictive__products" role="list">
            {%- for product in r.products -%}
              <li>
                <product-component
                  view-event-payload="{{ product | standard_event_data: 'view', context: 'search' | escape }}"
                >
                  <a href="{{ product.url }}" class="predictive__product" data-predictive-option>
                    <span class="media">
                      {%- if product.featured_media -%}
                        {{
                          product.featured_media
                          | image_url: width: 160
                          | image_tag: loading: 'lazy', alt: '', widths: '80, 160', sizes: '64px'
                        }}
                      {%- endif -%}
                    </span>
                    <span class="predictive__product-title">{{ product.title | escape }}</span>
                    {% render 'price', product: product, class: 'text-small' %}
                  </a>
                </product-component>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <a class="link predictive__all" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&options%5Bprefix%5D=last" data-predictive-option>
          {{- 'search.view_all' | t: terms: predictive_search.terms -}}
          {%- render 'icon', name: 'arrow-right' -%}
        </a>
      </div>
    </div>
  {%- else -%}
    <p class="text-muted" style="padding-top: 24px">{{ 'search.no_results' | t: terms: predictive_search.terms }}</p>
  {%- endif -%}
{%- endif -%}
