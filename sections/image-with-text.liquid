{%- assign s = section.settings -%}
<section class="iwt iwt--{{ s.layout }} dj-section color-{{ s.color_scheme }} pt-{{ s.padding_top }} pb-{{ s.padding_bottom }}">
  <div class="container iwt__grid">
    <div class="iwt__media media" style="--ratio: {{ s.ratio }}" data-reveal="mask">
      <div class="parallax" data-gsap="parallax" data-speed="6">
        {%- if s.image != blank -%}
          {%- assign img_alt = s.image.alt | default: s.heading | strip_html -%}
          {{
            s.image
            | image_url: width: 1800
            | image_tag: widths: '500, 800, 1100, 1400, 1800', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: img_alt
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
    </div>
    <div class="iwt__text">
      {%- if s.number != blank -%}
        <span class="iwt__num gold-text" data-reveal>{{ s.number | escape }}</span>
      {%- endif -%}
      {%- if s.eyebrow != blank -%}
        <p class="label label--accent label--line" data-reveal>{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 data-reveal style="--d: .08s">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="rte" data-reveal style="--d: .16s">{{ s.text }}</div>
      {%- endif -%}
      {%- if s.button_label != blank -%}
        <a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="btn btn--outline" data-magnetic data-reveal style="--d: .24s">
          <span class="btn__label">{{ s.button_label | escape }} {% render 'icon', name: 'arrow-right' %}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bild med text",
  "class": "section-iwt",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Bildformat",
      "options": [
        {
          "value": "4 / 5",
          "label": "Stående (4:5)"
        },
        {
          "value": "1 / 1",
          "label": "Kvadrat"
        },
        {
          "value": "3 / 2",
          "label": "Liggande (3:2)"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Bildens placering",
      "options": [
        {
          "value": "image-left",
          "label": "Vänster"
        },
        {
          "value": "image-right",
          "label": "Höger"
        }
      ],
      "default": "image-left"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Nummer",
      "info": "T.ex. 01 eller ett årtal."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etikett",
      "default": "Vår historia"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Rubrik",
      "default": "Född ur en <em>enkel idé</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>[FYLL I] Berätta hur De'Jour startade.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knapptext"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Knapplänk"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Avstånd ovanför",
      "options": [
        { "value": "none", "label": "Inget" },
        { "value": "sm", "label": "Litet" },
        { "value": "md", "label": "Mellan" },
        { "value": "lg", "label": "Stort" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Avstånd nedanför",
      "options": [
        { "value": "none", "label": "Inget" },
        { "value": "sm", "label": "Litet" },
        { "value": "md", "label": "Mellan" },
        { "value": "lg", "label": "Stort" }
      ],
      "default": "md"
    }
  ],
  "presets": [
    {
      "name": "Bild med text"
    }
  ]
}
{% endschema %}
