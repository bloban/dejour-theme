{%- assign s = section.settings -%}
<header class="password-header color-{{ s.color_scheme }}">
  <div class="password-header__inner">
    <span class="site-header__logo">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = settings.logo.alt | default: shop.name -%}
        {{ settings.logo | image_url: width: 600 | image_tag: widths: '150, 260, 400, 600', sizes: '260px', alt: logo_alt, loading: 'eager' }}
      {%- else -%}
        <span class="wordmark">{{ settings.wordmark | default: shop.name | escape }}</span>
      {%- endif -%}
    </span>

    <details class="password-login"{% if s.open_by_default %} open{% endif %} data-password-login>
      <summary class="link">
        {%- render 'icon', name: 'lock' -%}
        {{ 'password.enter' | t }}
      </summary>
      <div class="password-login__panel">
        {%- form 'storefront_password', class: 'password-login__form' -%}
          <label for="StorefrontPassword" class="label label--accent">{{ 'password.label' | t }}</label>
          <div class="inline-form">
            <input
              type="password"
              id="StorefrontPassword"
              name="password"
              autocomplete="current-password"
              placeholder="{{ 'password.placeholder' | t }}"
              {% if form.errors %}
                aria-invalid="true" aria-describedby="PasswordError"
              {% endif %}
            >
            <button type="submit">{{ 'password.submit' | t }} {% render 'icon', name: 'arrow-right' %}</button>
          </div>
          {%- if form.errors -%}
            <p id="PasswordError" class="form-msg form-msg--error" role="alert" style="display:flex">
              {%- render 'icon', name: 'error' -%}
              <span>{{ 'password.error' | t }}</span>
            </p>
            <script>
              document.querySelector('[data-password-login]').setAttribute('open', '');
            </script>
          {%- endif -%}
        {%- endform -%}
      </div>
    </details>
  </div>

  {%- if shop.password_message != blank -%}
    <p class="password-header__message label">{{ shop.password_message }}</p>
  {%- endif -%}
</header>

{% schema %}
{
  "name": "Lösenord – sidhuvud",
  "settings": [
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Visa lösenordsfältet direkt",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
