{%- assign s = section.settings -%}
<section class="richtext dj-section color-{{ s.color_scheme }} pt-{{ s.padding_top }} pb-{{ s.padding_bottom }}">
  <div class="{% if s.width == 'narrow' %}container--text{% else %}container--narrow{% endif %} richtext__inner richtext--{{ s.alignment }}">
    {%- if s.eyebrow != blank -%}
      <p class="label label--accent label--line" data-reveal>{{ s.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h2 data-reveal style="--d: .08s">{{ s.heading }}</h2>
    {%- endif -%}
    {%- if s.text != blank -%}
      <div class="rte" data-reveal style="--d: .16s">{{ s.text }}</div>
    {%- endif -%}
    {%- if s.button_label != blank -%}
      <div class="btn-group" data-reveal style="--d: .24s">
        <a href="{{ s.button_link | default: routes.root_url }}" class="btn btn--{{ s.button_style }}" data-magnetic>
          <span class="btn__label">{{ s.button_label | escape }}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Text",
  "class": "section-rich-text",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etikett"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Rubrik",
      "default": "Rubrik"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>[FYLL I]</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knapptext"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Knapplänk"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Knappstil",
      "options": [
        {
          "value": "primary",
          "label": "Guld"
        },
        {
          "value": "outline",
          "label": "Kontur"
        }
      ],
      "default": "outline"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Justering",
      "options": [
        {
          "value": "left",
          "label": "Vänster"
        },
        {
          "value": "center",
          "label": "Centrerad"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Bredd",
      "options": [
        {
          "value": "narrow",
          "label": "Smal"
        },
        {
          "value": "wide",
          "label": "Bred"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Avstånd ovanför",
      "options": [
        { "value": "none", "label": "Inget" },
        { "value": "sm", "label": "Litet" },
        { "value": "md", "label": "Mellan" },
        { "value": "lg", "label": "Stort" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Avstånd nedanför",
      "options": [
        { "value": "none", "label": "Inget" },
        { "value": "sm", "label": "Litet" },
        { "value": "md", "label": "Mellan" },
        { "value": "lg", "label": "Stort" }
      ],
      "default": "md"
    }
  ],
  "presets": [
    {
      "name": "Text"
    }
  ]
}
{% endschema %}
