{%- liquid
  assign menu_blocks = section.blocks | where: 'type', 'menu'
  assign text_blocks = section.blocks | where: 'type', 'text'
  assign col_count = section.blocks.size | at_least: 1
  assign wordmark = section.settings.wordmark_text | default: settings.wordmark | default: shop.name
-%}

<footer class="site-footer dj-section color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="footer__grid" style="--footer-cols: {{ col_count }}">
      <div class="footer__brand" data-reveal>
        {%- if section.settings.heading != blank -%}
          <h2 class="h3">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="footer__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.show_newsletter -%}
          {%- render 'notify-form',
            form_id: 'FooterNewsletter',
            tags: 'newsletter',
            button_label: section.settings.newsletter_button,
            success: section.settings.newsletter_success,
            legal: true
          -%}
        {%- endif -%}
        {%- if section.settings.show_social -%}
          {%- render 'social-icons' -%}
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div class="footer__col" data-reveal style="--d: {{ forloop.index | times: 0.08 }}s" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h2 class="footer__heading label label--accent">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              <ul class="footer__links" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- when 'text' -%}
              <div class="footer__text rte">{{ block.settings.text }}</div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.show_wordmark -%}
    <p class="footer__wordmark gold-text" aria-hidden="true" data-reveal="fade">{{ wordmark | escape }}</p>
  {%- endif -%}

  <div class="footer__bottom container">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>

    <ul class="footer__legal" role="list">
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}
          <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
        {%- endif -%}
      {%- endfor -%}
      {%- for link in section.settings.legal_menu.links -%}
        <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.show_localization -%}
      {%- render 'localization', form_id: 'FooterLocalization' -%}
    {%- endif -%}

    {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
      <ul class="payment-icons" role="list">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_powered_by -%}
      <span>{{ powered_by_link }}</span>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Sidfot",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Varumärke"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Rubrik",
      "default": "Tystare lyx. <em>Varje dag.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Få förtur till nästa drop och nyheter från ateljén. [FYLL I]</p>"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Visa nyhetsbrev",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Knapptext",
      "default": "Prenumerera"
    },
    {
      "type": "text",
      "id": "newsletter_success",
      "label": "Bekräftelse",
      "default": "Tack! Du står nu på listan."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Visa sociala medier",
      "default": true
    },
    {
      "type": "header",
      "content": "Ordmärke"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Visa stort ordmärke",
      "default": true
    },
    {
      "type": "text",
      "id": "wordmark_text",
      "label": "Text",
      "info": "Lämna tomt för att använda temats ordmärke."
    },
    {
      "type": "header",
      "content": "Nederkant"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Extra länkar",
      "info": "Butikens policyer visas automatiskt."
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Visa land- och språkväljare",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Visa betalikoner",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Visa 'Drivs av Shopify'",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Meny",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Rubrik",
          "default": "Handla"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Meny",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Rubrik",
          "default": "Kundservice"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>[FYLL I e-post]<br>Vardagar 9–17</p>"
        }
      ]
    }
  ]
}
{% endschema %}
