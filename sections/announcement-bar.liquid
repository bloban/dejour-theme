{%- if section.settings.text != blank -%}
  <div class="announcement color-{{ section.settings.color_scheme }} dj-section">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      <span>{{ section.settings.text | escape }}</span>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Tillkännagivande",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Fri frakt över 499 kr · 14 dagars ångerrätt"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Länk"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Tillkännagivande"
    }
  ]
}
{% endschema %}
