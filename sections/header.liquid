{%- liquid
  assign menu = section.settings.menu
  assign transparent = false
  if section.settings.transparent_home and template.name == 'index'
    assign transparent = true
  endif
  assign cart_is_drawer = false
  if settings.cart_type == 'drawer' and template.name != 'cart'
    assign cart_is_drawer = true
  endif
-%}

<site-header class="color-{{ section.settings.color_scheme }}">
  <header class="site-header" data-transparent="{{ transparent }}">
    <div class="site-header__inner">
      <div class="site-header__left">
        <button
          type="button"
          class="icon-btn site-header__burger"
          data-open="MenuDrawer"
          aria-controls="MenuDrawer"
          aria-expanded="false"
          aria-label="{{ 'header.menu' | t }}"
        >
          <span class="burger" aria-hidden="true"><span></span><span></span></span>
        </button>

        <nav class="site-nav" aria-label="{{ 'header.main_nav' | t }}">
          <ul class="site-nav__list" role="list">
            {%- for link in menu.links -%}
              <li>
                {%- if link.links != blank -%}
                  <details data-hover>
                    <summary class="site-nav__link"{% if link.child_active %} aria-current="page"{% endif %}>
                      {{- link.title | escape -}}
                      {%- render 'icon', name: 'chevron-down' -%}
                    </summary>
                    <div class="site-nav__dropdown">
                      <ul class="site-nav__dropdown-inner" role="list">
                        {%- for child in link.links -%}
                          <li>
                            <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>
                              {{- child.title | escape -}}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </details>
                {%- else -%}
                  <a href="{{ link.url }}" class="site-nav__link"{% if link.current %} aria-current="page"{% endif %}>
                    {{- link.title | escape -}}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      </div>

      <a href="{{ routes.root_url }}" class="site-header__logo">
        {%- if settings.logo != blank -%}
          {%- assign logo_alt = settings.logo.alt | default: shop.name -%}
          {{
            settings.logo
            | image_url: width: 600
            | image_tag:
              widths: '150, 260, 400, 600',
              sizes: '(min-width: 990px) 260px, 150px',
              alt: logo_alt,
              loading: 'eager'
          }}
        {%- else -%}
          <span class="wordmark">{{ settings.wordmark | default: shop.name | escape }}</span>
        {%- endif -%}
      </a>

      <div class="site-header__right">
        <a
          href="{{ routes.search_url }}"
          class="icon-btn"
          data-open="SearchOverlay"
          aria-controls="SearchOverlay"
          aria-expanded="false"
        >
          {%- render 'icon', name: 'search' -%}
          <span class="visually-hidden">{{ 'search.title' | t }}</span>
        </a>

        {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
          <a href="{{ routes.account_url }}" class="icon-btn hide-mobile">
            {%- render 'icon', name: 'account' -%}
            <span class="visually-hidden">
              {%- if customer -%}{{ 'header.account' | t }}{%- else -%}{{ 'header.log_in' | t }}{%- endif -%}
            </span>
          </a>
        {%- endif -%}

        <a
          href="{{ routes.cart_url }}"
          class="icon-btn"
          {% if cart_is_drawer %}
            data-open="CartDrawer" aria-controls="CartDrawer" aria-expanded="false"
          {% endif %}
        >
          {%- render 'icon', name: 'bag' -%}
          <span class="visually-hidden">{{ 'cart.title' | t }}</span>
          <span class="cart-count" data-cart-count data-count="{{ cart.item_count }}" aria-hidden="true">
            {{- cart.item_count -}}
          </span>
        </a>
      </div>
    </div>
  </header>
</site-header>

<dialog
  id="MenuDrawer"
  class="drawer drawer--left menu-drawer color-{{ section.settings.color_scheme }}"
  aria-label="{{ 'header.menu' | t }}"
>
  <div class="drawer__overlay" data-close></div>
  <div class="drawer__panel">
    <div class="drawer__head">
      <span class="label label--accent label--line">{{ 'header.menu' | t }}</span>
      <button type="button" class="icon-btn" data-close aria-label="{{ 'general.close' | t }}">
        {%- render 'icon', name: 'close' -%}
      </button>
    </div>
    <div class="drawer__body drawer__body--flush">
      <nav class="menu-drawer__nav" aria-label="{{ 'header.main_nav' | t }}">
        <ul class="menu-drawer__list" role="list">
          {%- for link in menu.links -%}
            <li class="menu-drawer__item" style="--i: {{ forloop.index }}">
              {%- if link.links != blank -%}
                <details>
                  <summary class="menu-drawer__link">
                    {{- link.title | escape -}}
                    {%- render 'icon', name: 'plus' -%}
                  </summary>
                  <ul class="menu-drawer__sub" role="list">
                    {%- for child in link.links -%}
                      <li>
                        <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>
                          {{- child.title | escape -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a href="{{ link.url }}" class="menu-drawer__link"{% if link.current %} aria-current="page"{% endif %}>
                  {{- link.title | escape -}}
                  <span class="menu-drawer__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <div class="menu-drawer__secondary">
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" class="link">
            {%- if customer -%}{{ 'header.account' | t }}{%- else -%}{{ 'header.log_in' | t }}{%- endif -%}
          </a>
        {%- endif -%}
        {%- render 'social-icons' -%}
        {%- render 'localization', form_id: 'MenuLocalization' -%}
      </div>
    </div>
  </div>
</dialog>

<dialog id="SearchOverlay" class="drawer drawer--top search-overlay" aria-label="{{ 'search.title' | t }}">
  <div class="drawer__overlay" data-close></div>
  <div class="drawer__panel">
    <predictive-search data-enabled="{{ settings.predictive_search_enabled }}">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-overlay__form">
        <label class="label label--accent label--line" for="SearchOverlayInput">{{ 'search.title' | t }}</label>
        <div class="search-overlay__field">
          {%- render 'icon', name: 'search' -%}
          <input
            id="SearchOverlayInput"
            class="search-overlay__input"
            type="search"
            name="q"
            placeholder="{{ 'search.placeholder' | t }}"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            autofocus
            aria-controls="PredictiveResults"
          >
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" class="visually-hidden">{{ 'search.submit' | t }}</button>
        </div>
      </form>
      <div id="PredictiveResults" class="search-overlay__results" data-predictive-results></div>
    </predictive-search>
    <button type="button" class="icon-btn search-overlay__close" data-close aria-label="{{ 'general.close' | t }}">
      {%- render 'icon', name: 'close' -%}
    </button>
  </div>
</dialog>

{%- if request.page_type == 'index' -%}
  {%- liquid
    assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}'
  -%}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      {% if settings.logo %}
        "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
      {% endif %}
      "sameAs": [
        {{ settings.social_instagram_link | json }},
        {{ settings.social_tiktok_link | json }},
        {{ settings.social_facebook_link | json }},
        {{ settings.social_youtube_link | json }},
        {{ settings.social_pinterest_link | json }},
        {{ settings.social_twitter_link | json }}
      ],
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "max_blocks": 0,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Meny",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "transparent_home",
      "label": "Transparent över heron på startsidan",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Visa kontoikon",
      "info": "Kräver att kundkonton är aktiverade i Shopify.",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
