{%- assign s = section.settings -%}
<section class="page-content dj-section color-{{ s.color_scheme }} pt-{{ s.padding_top }} pb-{{ s.padding_bottom }}">
  <div class="container--text">
    {%- if s.show_title -%}
      <h1 class="h2">{{ page.title | escape }}</h1>
    {%- endif -%}
    <div class="rte page-content__body" data-reveal>{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Sidans innehåll",
  "class": "section-main-page",
  "settings": [
    {
      "type": "paragraph",
      "content": "Visar texten du skriver under Webbshop → Sidor i Shopify."
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Visa sidans titel",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Avstånd ovanför",
      "options": [
        { "value": "none", "label": "Inget" },
        { "value": "sm", "label": "Litet" },
        { "value": "md", "label": "Mellan" },
        { "value": "lg", "label": "Stort" }
      ],
      "default": "sm"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Avstånd nedanför",
      "options": [
        { "value": "none", "label": "Inget" },
        { "value": "sm", "label": "Litet" },
        { "value": "md", "label": "Mellan" },
        { "value": "lg", "label": "Stort" }
      ],
      "default": "lg"
    }
  ]
}
{% endschema %}
