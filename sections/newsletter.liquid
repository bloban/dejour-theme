{%- liquid
  assign s = section.settings
  assign form_id = 'Newsletter-' | append: section.id
  assign tags = s.tags | default: 'newsletter'
-%}
<section class="newsletter dj-section color-{{ s.color_scheme }} pt-{{ s.padding_top }} pb-{{ s.padding_bottom }}">
  {%- if s.image != blank -%}
    <div class="newsletter__bg" aria-hidden="true">
      <div class="parallax" data-gsap="parallax" data-speed="8">
        {{
          s.image
          | image_url: width: 2400
          | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', loading: 'lazy', alt: ''
        }}
      </div>
    </div>
  {%- endif -%}
  <div class="container--narrow newsletter__inner">
    {%- if s.eyebrow != blank -%}
      <p class="label label--accent label--line" data-reveal>{{ s.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h2 class="h1" data-reveal style="--d: .08s">{{ s.heading }}</h2>
    {%- endif -%}
    {%- if s.text != blank -%}
      <div class="lead" data-reveal style="--d: .16s">{{ s.text }}</div>
    {%- endif -%}
    <div class="newsletter__form" data-reveal style="--d: .24s">
      {%- render 'notify-form',
        form_id: form_id,
        tags: tags,
        button_label: s.button_label,
        success: s.success,
        legal: true
      -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nyhetsbrev",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etikett",
      "default": "Inner circle"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Rubrik",
      "default": "Först till <em>nästa drop</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Förtur till släpp, begränsade upplagor och inget brus. [FYLL I]</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knapptext",
      "default": "Gå med"
    },
    {
      "type": "text",
      "id": "success",
      "label": "Bekräftelse",
      "default": "Välkommen. Vi hör av oss före nästa drop."
    },
    {
      "type": "text",
      "id": "tags",
      "label": "Kundtaggar",
      "info": "Kommaseparerade. Använd t.ex. 'newsletter, drop-svart' på droppsidan.",
      "default": "newsletter"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bakgrundsbild"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-5"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Avstånd ovanför",
      "options": [
        { "value": "none", "label": "Inget" },
        { "value": "sm", "label": "Litet" },
        { "value": "md", "label": "Mellan" },
        { "value": "lg", "label": "Stort" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Avstånd nedanför",
      "options": [
        { "value": "none", "label": "Inget" },
        { "value": "sm", "label": "Litet" },
        { "value": "md", "label": "Mellan" },
        { "value": "lg", "label": "Stort" }
      ],
      "default": "lg"
    }
  ],
  "presets": [
    {
      "name": "Nyhetsbrev"
    }
  ]
}
{% endschema %}
