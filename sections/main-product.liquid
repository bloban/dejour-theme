{{ 'product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign current = product.selected_or_first_available_variant

  assign tags_down = product.tags | join: '|' | downcase | split: '|'
  assign drop_tag = settings.drop_product_tag | strip | downcase
  assign is_drop = false
  if settings.drop_enabled and drop_tag != blank and tags_down contains drop_tag
    assign is_drop = true
  endif
  assign drop_state = ''
  if is_drop
    capture drop_info
      render 'drop-state', date: settings.drop_date, time: settings.drop_time
    endcapture
    assign drop_state = drop_info | strip | split: '|' | first
    if drop_state == 'invalid'
      assign is_drop = false
    endif
  endif

  assign siblings = product.metafields.custom.color_siblings.value
  if siblings == blank and s.siblings_collection != blank
    assign siblings = s.siblings_collection.products
  endif

  assign first_model = product.media | where: 'media_type', 'model' | first
-%}

{%- if first_model -%}
  <link
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
    media="print"
    onload="this.media='all'"
  >
{%- endif -%}

<product-component view-event-payload="{{ product | standard_event_data: 'view', context: 'page' | escape }}">
  <section
    class="product dj-section color-{{ s.color_scheme }} pb-{{ s.padding_bottom }}"
    data-drop-scope
    {% if is_drop %}
      data-drop-state="{{ drop_state }}"
    {% endif %}
  >
    <div class="container">
      <div class="product__grid">
        <div class="product__media">
          {%- render 'product-gallery',
            product: product,
            section_id: section.id,
            zoom: s.enable_zoom,
            layout: s.gallery_layout,
            ratio: s.media_ratio
          -%}
        </div>

        <div class="product__info{% if s.sticky_info %} product__info--sticky{% endif %}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                <div class="product__block" {{ block.shopify_attributes }}>{% render block %}</div>

              {%- when 'title' -%}
                <div class="product__block product__head" {{ block.shopify_attributes }}>
                  {%- if block.settings.show_eyebrow -%}
                    <p class="label label--accent label--line">
                      {%- if product.type != blank -%}{{ product.type | escape }}{%- else -%}{{ product.vendor | escape }}{%- endif -%}
                    </p>
                  {%- endif -%}
                  <h1 class="product__title">{{ product.title | escape }}</h1>
                  {%- liquid
                    assign archive_tag = settings.archive_tag | strip | downcase
                    assign release_date = product.metafields.custom.release_date.value | default: product.published_at
                  -%}
                  {%- if archive_tag != blank and tags_down contains archive_tag -%}
                    <p class="product__archive">
                      <span class="badge badge--muted">
                        {%- if product.available -%}{{ 'products.badge_previous_drop' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
                      </span>
                      <span class="label">{{ 'products.released_on' | t }} {% render 'format-date', date: release_date %}</span>
                    </p>
                  {%- endif -%}
                </div>

              {%- when 'price' -%}
                <div class="product__block product__price" {{ block.shopify_attributes }}>
                  <div data-price>{% render 'price', product: product, variant: current %}</div>
                  {%- if block.settings.show_tax -%}
                    <p class="product__tax">
                      {%- if cart.taxes_included -%}
                        {{ 'products.tax_included' | t }}
                      {%- else -%}
                        {{ 'products.tax_excluded' | t }}
                      {%- endif -%}
                      {%- if shop.shipping_policy.body != blank -%}
                        <span aria-hidden="true"> · </span>
                        <a href="{{ shop.shipping_policy.url }}" class="text-link">{{ 'products.shipping_calculated' | t }}</a>
                      {%- endif -%}
                    </p>
                  {%- endif -%}
                </div>

              {%- when 'rating' -%}
                {%- if product.metafields.reviews.rating.value != blank -%}
                  {%- liquid
                    assign rating_value = product.metafields.reviews.rating.value.rating | round: 1
                    assign rating_max = product.metafields.reviews.rating.value.scale_max
                    assign rating_count = product.metafields.reviews.rating_count
                  -%}
                  <a href="#reviews" class="product__block product__rating" {{ block.shopify_attributes }}>
                    <span class="stars" aria-hidden="true">
                      {%- for i in (1..5) -%}
                        {%- if i <= rating_value -%}
                          {%- render 'icon', name: 'star' -%}
                        {%- else -%}
                          {%- render 'icon', name: 'star-outline' -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </span>
                    <span class="text-small">{{ rating_value }} / {{ rating_max }} ({{ rating_count }})</span>
                    <span class="visually-hidden">{{ 'general.rating' | t: rating: rating_value }}</span>
                  </a>
                {%- endif -%}

              {%- when 'text' -%}
                <div class="product__block rte text-small" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="product__block product__desc rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
                {%- endif -%}

              {%- when 'variant_picker' -%}
                <div class="product__block" {{ block.shopify_attributes }}>
                  {%- render 'variant-picker',
                    product: product,
                    section_id: section.id,
                    siblings: siblings,
                    siblings_label: block.settings.siblings_label
                  -%}
                </div>

              {%- when 'buy_buttons' -%}
                <div class="product__block" id="BuyBox-{{ section.id }}" {{ block.shopify_attributes }}>
                  {%- render 'buy-box',
                    product: product,
                    section_id: section.id,
                    show_quantity: block.settings.show_quantity,
                    show_dynamic_checkout: block.settings.show_dynamic_checkout
                  -%}
                </div>

              {%- when 'drop_countdown' -%}
                {%- if is_drop or block.settings.always -%}
                  {%- liquid
                    assign drop_block_form = 'DropBlock-' | append: block.id
                    assign block_attrs = block.shopify_attributes
                  -%}
                  <div class="product__block">
                    {%- render 'drop-compact',
                      date: settings.drop_date,
                      time: settings.drop_time,
                      eyebrow: block.settings.eyebrow,
                      heading: block.settings.heading,
                      show_notify: false,
                      tag: settings.drop_customer_tag,
                      form_id: drop_block_form,
                      live_label: '',
                      live_url: '',
                      show_seconds: true,
                      attrs: block_attrs
                    -%}
                  </div>
                {%- endif -%}

              {%- when 'usp_list' -%}
                <ul class="product__block p-usps" role="list" {{ block.shopify_attributes }}>
                  {%- for i in (1..3) -%}
                    {%- liquid
                      assign text_key = 'text_' | append: i
                      assign icon_key = 'icon_' | append: i
                      assign usp_text = block.settings[text_key]
                    -%}
                    {%- if usp_text != blank -%}
                      <li>{% render 'icon', name: block.settings[icon_key] %}<span>{{ usp_text | escape }}</span></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>

              {%- when 'accordion' -%}
                {%- liquid
                  assign acc_content = block.settings.content
                  if block.settings.source == 'description'
                    assign acc_content = product.description
                  elsif block.settings.source == 'page' and block.settings.page != blank
                    assign acc_content = block.settings.page.content
                  endif
                -%}
                {%- if acc_content != blank -%}
                  <div class="product__block accordion accordion--compact accordion--product" {{ block.shopify_attributes }}>
                    <details class="accordion__item"{% if block.settings.open %} open{% endif %}>
                      <summary>
                        <span class="accordion__title">
                          {%- if block.settings.icon != 'none' -%}
                            {%- render 'icon', name: block.settings.icon -%}
                          {%- endif -%}
                          {{ block.settings.heading | escape }}
                        </span>
                        <span class="accordion__icon" aria-hidden="true"></span>
                      </summary>
                      <div class="accordion__content rte">{{ acc_content }}</div>
                    </details>
                  </div>
                {%- endif -%}

              {%- when 'custom_liquid' -%}
                <div class="product__block" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- if s.show_sticky_buy -%}
      <sticky-buy class="sticky-buy" data-target="BuyBox-{{ section.id }}" aria-hidden="true">
        <div class="sticky-buy__media media">
          {%- if product.featured_media -%}
            {{
              product.featured_media
              | image_url: width: 120
              | image_tag: loading: 'lazy', alt: '', widths: '60, 120', sizes: '44px'
            }}
          {%- endif -%}
        </div>
        <div class="sticky-buy__info">
          <span class="sticky-buy__title">{{ product.title | escape }}</span>
          <span class="sticky-buy__price" data-sticky-price>
            {%- render 'price', product: product, variant: current -%}
          </span>
        </div>
        {%- if is_drop -%}
          <a href="#BuyBox-{{ section.id }}" class="btn btn--outline btn--sm drop-pre" tabindex="-1">
            <span class="btn__label">{{ 'drop.notify_button' | t }}</span>
          </a>
        {%- endif -%}
        {%- if product.available -%}
          <button
            type="submit"
            form="ProductForm-{{ section.id }}"
            name="add"
            class="btn btn--primary btn--sm{% if is_drop %} drop-live{% endif %}"
            data-sticky-add
            tabindex="-1"
            {% unless current.available %}
              disabled
            {% endunless %}
          >
            <span class="btn__label" data-add-label>
              {%- if current.available -%}
                {{ 'products.add_short' | t }}
              {%- else -%}
                {{ 'products.sold_out' | t }}
              {%- endif -%}
            </span>
          </button>
        {%- else -%}
          <a href="#BuyBox-{{ section.id }}" class="btn btn--outline btn--sm" tabindex="-1">
            <span class="btn__label">{{ 'products.restock_short' | t }}</span>
          </a>
        {%- endif -%}
      </sticky-buy>
    {%- endif -%}
  </section>
</product-component>

{%- if first_model -%}
  <script type="application/json" id="ProductJSON-{{ product.id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>
{%- endif -%}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Produktinformation",
  "class": "section-main-product",
  "settings": [
    {
      "type": "header",
      "content": "Galleri"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Layout på desktop",
      "options": [
        {
          "value": "grid",
          "label": "Stor första bild + rutnät"
        },
        {
          "value": "stack",
          "label": "En kolumn"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Bildformat",
      "options": [
        {
          "value": "portrait",
          "label": "Stående (4:5)"
        },
        {
          "value": "square",
          "label": "Kvadrat"
        },
        {
          "value": "natural",
          "label": "Bildens eget format"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Zoom vid hovring och helskärmsvisning",
      "default": true
    },
    {
      "type": "header",
      "content": "Information"
    },
    {
      "type": "checkbox",
      "id": "sticky_info",
      "label": "Lås informationen vid scroll (desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sticky_buy",
      "label": "Fast köpknapp längst ned på mobil",
      "default": true
    },
    {
      "type": "collection",
      "id": "siblings_collection",
      "label": "Kollektion med färgsyskon",
      "info": "Visas som färgprover. Kan ersättas per produkt med metafältet custom.color_siblings (lista med produkter). Färgen hämtas från custom.swatch_color eller produktnamnet."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Avstånd nedanför",
      "options": [
        { "value": "none", "label": "Inget" },
        { "value": "sm", "label": "Litet" },
        { "value": "md", "label": "Mellan" },
        { "value": "lg", "label": "Stort" }
      ],
      "default": "md"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "Titel",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_eyebrow",
          "label": "Visa produkttyp ovanför",
          "default": true
        }
      ]
    },
    {
      "type": "price",
      "name": "Pris",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_tax",
          "label": "Visa momsinformation",
          "default": true
        }
      ]
    },
    {
      "type": "rating",
      "name": "Betyg",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Visar betyg från en recensionsapp som fyller i metafälten reviews.rating och reviews.rating_count."
        }
      ]
    },
    {
      "type": "description",
      "name": "Beskrivning",
      "limit": 1,
      "settings": []
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>[FYLL I]</p>"
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variantväljare",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "siblings_label",
          "label": "Rubrik för färgsyskon",
          "default": "Färg"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Köpknappar",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Drop-produkter (se Temainställningar → Drop) visar nedräkning och 'Påminn mig' tills droppet startar. Slutsålda produkter visar 'Bevaka'."
        },
        {
          "type": "checkbox",
          "id": "show_quantity",
          "label": "Visa antalsväljare",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Visa snabbkassa (Shop Pay, Apple Pay, Klarna m.fl.)",
          "default": true
        }
      ]
    },
    {
      "type": "drop_countdown",
      "name": "Drop-nedräkning",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Kompakt nedräkning. Visas bara på drop-produkter om inte 'Visa alltid' är ikryssad."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Etikett",
          "default": "Drop 01 — The Black Edition"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Rubrik",
          "default": "Begränsad <em>upplaga</em>"
        },
        {
          "type": "checkbox",
          "id": "always",
          "label": "Visa alltid",
          "default": false
        }
      ]
    },
    {
      "type": "usp_list",
      "name": "Trygghetspunkter",
      "limit": 2,
      "settings": [
        {
          "type": "select",
          "id": "icon_1",
          "label": "Ikon 1",
          "options": [
            { "value": "truck", "label": "Frakt" },
            { "value": "return", "label": "Retur" },
            { "value": "lock", "label": "Lås" },
            { "value": "shield", "label": "Sköld" },
            { "value": "rfid", "label": "RFID" },
            { "value": "gift", "label": "Present" },
            { "value": "clock", "label": "Klocka" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "text_1",
          "label": "Text 1",
          "default": "Fri frakt över 499 kr med PostNord"
        },
        {
          "type": "select",
          "id": "icon_2",
          "label": "Ikon 2",
          "options": [
            { "value": "truck", "label": "Frakt" },
            { "value": "return", "label": "Retur" },
            { "value": "lock", "label": "Lås" },
            { "value": "shield", "label": "Sköld" },
            { "value": "rfid", "label": "RFID" },
            { "value": "gift", "label": "Present" },
            { "value": "clock", "label": "Klocka" }
          ],
          "default": "return"
        },
        {
          "type": "text",
          "id": "text_2",
          "label": "Text 2",
          "default": "14 dagars ångerrätt"
        },
        {
          "type": "select",
          "id": "icon_3",
          "label": "Ikon 3",
          "options": [
            { "value": "truck", "label": "Frakt" },
            { "value": "return", "label": "Retur" },
            { "value": "lock", "label": "Lås" },
            { "value": "shield", "label": "Sköld" },
            { "value": "rfid", "label": "RFID" },
            { "value": "gift", "label": "Present" },
            { "value": "clock", "label": "Klocka" }
          ],
          "default": "lock"
        },
        {
          "type": "text",
          "id": "text_3",
          "label": "Text 3",
          "default": "Säker och krypterad betalning"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Dragspel",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Rubrik",
          "default": "Detaljer"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Ikon",
          "options": [
            { "value": "none", "label": "Ingen" },
            { "value": "leather", "label": "Läder" },
            { "value": "ruler", "label": "Mått" },
            { "value": "needle", "label": "Sömmar" },
            { "value": "truck", "label": "Frakt" },
            { "value": "return", "label": "Retur" },
            { "value": "sparkle", "label": "Skötsel" },
            { "value": "card", "label": "Kort" }
          ],
          "default": "none"
        },
        {
          "type": "select",
          "id": "source",
          "label": "Innehåll",
          "options": [
            { "value": "custom", "label": "Egen text" },
            { "value": "description", "label": "Produktbeskrivning" },
            { "value": "page", "label": "Sida" }
          ],
          "default": "custom"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Egen text",
          "info": "Koppla gärna till ett produktmetafält via dynamisk källa."
        },
        {
          "type": "page",
          "id": "page",
          "label": "Sida"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Öppen från början",
          "default": false
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Egen Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Liquid"
        }
      ]
    }
  ]
}
{% endschema %}
