{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section class="cart-page dj-section color-{{ s.color_scheme }} pb-lg">
  <div class="container" data-cart-section="{{ section.id }}">
    <span hidden data-cart-count-value="{{ cart.item_count }}"></span>
    <header class="cart-page__head">
      <p class="label label--accent label--line">{{ 'cart.your_bag' | t }}</p>
      <h1 class="h1">{{ 'cart.title' | t }} <span class="cart-page__count">({{ cart.item_count }})</span></h1>
    </header>

    {%- if cart.item_count > 0 -%}
      <div class="cart-page__grid">
        <div class="cart-page__lines">
          <ul class="cart-lines" role="list">
            {%- for item in cart.items -%}
              {%- render 'cart-line', item: item, index: forloop.index, sizes: '(min-width: 750px) 140px, 88px' -%}
            {%- endfor -%}
          </ul>
          <a href="{{ routes.all_products_collection_url }}" class="link cart-page__continue">
            {%- render 'icon', name: 'arrow-left' -%}
            {{ 'cart.continue_shopping' | t }}
          </a>
        </div>

        <aside class="cart-page__summary">
          <form action="{{ routes.cart_url }}" method="post" id="CartPageForm" novalidate>
            {%- render 'free-shipping' -%}

            {%- if settings.cart_note_enabled -%}
              <details class="cart-note">
                <summary>{{ 'cart.note_toggle' | t }}</summary>
                <label for="CartPageNote" class="visually-hidden">{{ 'cart.note' | t }}</label>
                <textarea id="CartPageNote" class="field__input" name="note" data-cart-note placeholder=" ">
                  {{- cart.note -}}
                </textarea>
              </details>
            {%- endif -%}

            <div class="cart-totals">
              {%- for discount in cart.cart_level_discount_applications -%}
                <div class="cart-totals__row cart-totals__discount">
                  <span>{{ discount.title | escape }}</span>
                  <span>−{{ discount.total_allocated_amount | money }}</span>
                </div>
              {%- endfor -%}
              <div class="cart-totals__row cart-totals__row--total">
                <span>{{ 'cart.subtotal' | t }}</span>
                <span class="cart-totals__value">
                  {%- if settings.currency_code_enabled -%}
                    {{ cart.total_price | money_with_currency }}
                  {%- else -%}
                    {{ cart.total_price | money }}
                  {%- endif -%}
                </span>
              </div>
            </div>

            <p class="cart-tax">
              {%- if cart.duties_included and cart.taxes_included -%}
                {{ 'cart.duties_and_taxes_included' | t }}
              {%- elsif cart.taxes_included -%}
                {{ 'cart.taxes_included' | t }}
              {%- else -%}
                {{ 'cart.taxes_at_checkout' | t }}
              {%- endif -%}
            </p>

            <button type="submit" name="checkout" class="btn btn--primary btn--block btn--lg">
              <span class="btn__label">
                {%- render 'icon', name: 'lock' -%}
                {{- 'cart.checkout' | t -}}
              </span>
            </button>

            {%- if additional_checkout_buttons and s.show_additional_checkout -%}
              <div class="cart-page__dynamic">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}

            {%- if settings.cart_trust_text != blank -%}
              <p class="cart-trust">{{ settings.cart_trust_text | escape }}</p>
            {%- endif -%}
          </form>
        </aside>
      </div>
    {%- else -%}
      <div class="cart-empty cart-page__empty">
        <p class="h3">{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" data-magnetic>
          <span class="btn__label">{{ 'cart.continue' | t }}</span>
        </a>
        {%- if shop.customer_accounts_enabled and customer == null -%}
          <p class="text-small text-muted">
            {{ 'cart.login_hint_html' | t: url: routes.account_login_url }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Varukorg",
  "class": "section-main-cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_additional_checkout",
      "label": "Visa snabbkassa (Shop Pay, Apple Pay m.fl.)",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
