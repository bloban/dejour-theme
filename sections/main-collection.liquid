{{ 'collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign card_mode = 'default'
  if s.archive_mode
    assign card_mode = 'archive'
  endif
  assign cols_mobile = s.columns_mobile | plus: 0
  assign desk_vw = 100 | divided_by: s.columns
  assign mob_vw = 100 | divided_by: cols_mobile
  assign grid_sizes = '(min-width: 990px) ' | append: desk_vw | append: 'vw, ' | append: mob_vw | append: 'vw'
  assign show_image = false
  if s.show_image and collection.image
    assign show_image = true
  endif
-%}

<section class="collection dj-section color-{{ s.color_scheme }} pb-{{ s.padding_bottom }}">
  <header class="collection-hero{% if show_image %} collection-hero--image{% endif %}">
    {%- if show_image -%}
      <div class="collection-hero__media" aria-hidden="true">
        <div class="parallax" data-gsap="parallax" data-speed="8">
          {{
            collection.image
            | image_url: width: 2400
            | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: ''
          }}
        </div>
      </div>
    {%- endif -%}
    <div class="container collection-hero__inner">
      {%- if s.eyebrow != blank -%}
        <p class="label label--accent label--line hero__fade" style="--d: .1s">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="collection-hero__title hero__fade" style="--d: .2s">{{ collection.title | escape }}</h1>
      {%- if s.show_description and collection.description != blank -%}
        <div class="collection-hero__desc lead rte hero__fade" style="--d: .3s">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </header>

  <collection-component view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
    <facet-results
      class="container"
      data-section="{{ section.id }}"
      data-template="collection"
      data-collection-id="{{ collection.id }}"
      data-collection-handle="{{ collection.handle }}"
    >
      {%- paginate collection.products by s.per_page -%}
        <div data-facets-wrap>
          {%- render 'results-toolbar',
            results: collection,
            section_id: section.id,
            count: collection.products_count,
            show_filter: s.enable_filtering,
            show_sort: s.enable_sorting
          -%}

          {%- if collection.products.size > 0 -%}
            <ul
              class="grid collection__grid"
              role="list"
              style="--cols: {{ s.columns }}; --cols-tablet: {{ s.columns | at_most: 3 }}; --cols-mobile: {{ cols_mobile }}"
            >
              {%- for p in collection.products -%}
                <li>
                  {%- liquid
                    assign eager = false
                    if forloop.index <= s.columns
                      assign eager = true
                    endif
                  -%}
                  {%- render 'product-card',
                    card_product: p,
                    index: forloop.index0,
                    sizes: grid_sizes,
                    mode: card_mode,
                    eager: eager,
                    context: 'collection'
                  -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <div class="collection__empty">
              <p class="h3">{{ 'collections.empty' | t }}</p>
              {%- if collection.filters.size > 0 -%}
                <a href="{{ collection.url }}" class="link" data-facet-link>{{ 'collections.clear_all' | t }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- render 'paginate-links', paginate: paginate -%}
        </div>

        {%- if s.enable_filtering or s.enable_sorting -%}
          {%- render 'filter-drawer', results: collection, section_id: section.id, count: collection.products_count -%}
        {%- endif -%}
      {%- endpaginate -%}
    </facet-results>
  </collection-component>
</section>

{% schema %}
{
  "name": "Kollektion",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etikett",
      "default": "Kollektion"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Visa kollektionens bild",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Visa kollektionens beskrivning",
      "default": true
    },
    {
      "type": "range",
      "id": "per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Produkter per sida",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Kolumner på desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Kolumner på mobil",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Filter",
      "info": "Ställs in i appen Search & Discovery.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Sortering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "archive_mode",
      "label": "Arkivläge",
      "info": "Gråtonade bilder, etiketterna 'Tidigare drop'/'Slutsåld' och släppdatum.",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Avstånd nedanför",
      "options": [
        { "value": "none", "label": "Inget" },
        { "value": "sm", "label": "Litet" },
        { "value": "md", "label": "Mellan" },
        { "value": "lg", "label": "Stort" }
      ],
      "default": "lg"
    }
  ]
}
{% endschema %}
