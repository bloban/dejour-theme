{%- assign s = section.settings -%}
<footer class="password-footer color-{{ s.color_scheme }}">
  {%- render 'social-icons' -%}
  <p class="text-small text-muted">
    &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }} · {{ 'password.owner_html' | t: url: '/admin' }}
  </p>
</footer>

{% schema %}
{
  "name": "Lösenord – sidfot",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
