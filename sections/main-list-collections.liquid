{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section class="list-collections dj-section color-{{ s.color_scheme }} pb-lg">
  <header class="collection-hero">
    <div class="container collection-hero__inner">
      <p class="label label--accent label--line hero__fade">{{ s.eyebrow | escape }}</p>
      <h1 class="collection-hero__title hero__fade" style="--d: .1s">{{ s.heading | default: page_title | escape }}</h1>
    </div>
  </header>

  <div class="container">
    {%- paginate collections by 24 -%}
      <ul class="grid list-collections__grid" role="list" style="--cols: {{ s.columns }}; --cols-tablet: 2; --cols-mobile: 1">
        {%- for c in collections -%}
          {%- liquid
            assign img = c.featured_image
            if img == blank
              assign img = c.products.first.featured_media.preview_image
            endif
            assign img_alt = c.title
          -%}
          <li>
            <a href="{{ c.url }}" class="collection-card" data-reveal style="--d: {{ forloop.index0 | modulo: 3 | times: 0.08 }}s">
              <span class="collection-card__media media">
                {%- if img -%}
                  {{
                    img
                    | image_url: width: 1400
                    | image_tag: widths: '400, 700, 1000, 1400', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: img_alt
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
                {%- endif -%}
              </span>
              <span class="collection-card__info">
                <span class="collection-card__title">{{ c.title | escape }}</span>
                <span class="label">{{ 'collections.product_count' | t: count: c.products_count }}</span>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- render 'paginate-links', paginate: paginate -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Kollektionslista",
  "class": "section-list-collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etikett",
      "default": "Utforska"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Kollektioner"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Kolumner på desktop",
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
