{%- liquid
  assign s = section.settings
  assign manual = s.products
  assign desk_vw = 100 | divided_by: s.columns
  assign grid_sizes = '(min-width: 990px) ' | append: desk_vw | append: 'vw, 50vw'
-%}

{%- capture head -%}
  <div class="section-head section-head--split">
    <div class="section-head__text">
      {%- if s.eyebrow != blank -%}
        <p class="label label--accent label--line" data-reveal>{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 data-reveal style="--d: .08s">{{ s.heading }}</h2>
      {%- endif -%}
    </div>
  </div>
{%- endcapture -%}

<section class="related dj-section color-{{ s.color_scheme }} pt-{{ s.padding_top }} pb-{{ s.padding_bottom }}">
  <div class="container">
    {%- if manual.size > 0 -%}
      {{ head }}
      <ul class="grid" role="list" style="--cols: {{ s.columns }}; --cols-tablet: 3; --cols-mobile: 2">
        {%- for p in manual limit: s.limit -%}
          <li>{% render 'product-card', card_product: p, index: forloop.index0, sizes: grid_sizes, context: 'recommendation' %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <product-recommendations
        data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.limit }}"
        data-intent="complementary"
      >
        <div data-recs-content>
          {%- if recommendations.performed? and recommendations.products_count > 0 -%}
            {{ head }}
            <ul class="grid" role="list" style="--cols: {{ s.columns }}; --cols-tablet: 3; --cols-mobile: 2">
              {%- for p in recommendations.products -%}
                <li>{% render 'product-card', card_product: p, index: forloop.index0, sizes: grid_sizes, context: 'recommendation' %}</li>
              {%- endfor -%}
            </ul>
          {%- elsif request.design_mode -%}
            {{ head }}
            <p class="text-muted text-small">{{ 'products.recommendations_hint' | t }}</p>
          {%- endif -%}
        </div>
      </product-recommendations>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Passar bra med",
  "class": "section-related",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Visar kompletterande produkter från appen Search & Discovery, annars liknande produkter. Du kan också välja produkter manuellt."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etikett",
      "default": "Komplettera"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Rubrik",
      "default": "Passar bra <em>med</em>"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Välj produkter manuellt",
      "limit": 8
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Antal produkter",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Kolumner på desktop",
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Avstånd ovanför",
      "options": [
        { "value": "none", "label": "Inget" },
        { "value": "sm", "label": "Litet" },
        { "value": "md", "label": "Mellan" },
        { "value": "lg", "label": "Stort" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Avstånd nedanför",
      "options": [
        { "value": "none", "label": "Inget" },
        { "value": "sm", "label": "Litet" },
        { "value": "md", "label": "Mellan" },
        { "value": "lg", "label": "Stort" }
      ],
      "default": "md"
    }
  ],
  "presets": [
    {
      "name": "Passar bra med"
    }
  ]
}
{% endschema %}
