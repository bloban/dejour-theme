{{ 'collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign desk_vw = 100 | divided_by: s.columns
  assign grid_sizes = '(min-width: 990px) ' | append: desk_vw | append: 'vw, 50vw'
  assign terms = search.terms
-%}

<section class="search-page dj-section color-{{ s.color_scheme }} pb-lg">
  <header class="collection-hero">
    <div class="container collection-hero__inner">
      <p class="label label--accent label--line">{{ 'search.title' | t }}</p>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
        <label for="SearchPageInput" class="visually-hidden">{{ 'search.title' | t }}</label>
        <input
          id="SearchPageInput"
          class="search-page__input"
          type="search"
          name="q"
          value="{{ terms | escape }}"
          placeholder="{{ 'search.placeholder' | t }}"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="icon-btn" aria-label="{{ 'search.submit' | t }}">
          {%- render 'icon', name: 'arrow-right' -%}
        </button>
      </form>
    </div>
  </header>

  <facet-results class="container" data-section="{{ section.id }}" data-template="search">
    {%- if search.performed -%}
      {%- paginate search.results by s.per_page -%}
        <div data-facets-wrap>
          {%- if search.results_count > 0 or search.filters.size > 0 -%}
            {%- render 'results-toolbar',
              results: search,
              section_id: section.id,
              count: search.results_count,
              show_filter: s.enable_filtering,
              show_sort: s.enable_sorting
            -%}
          {%- endif -%}

          {%- if search.results_count > 0 -%}
            <ul class="grid" role="list" style="--cols: {{ s.columns }}; --cols-tablet: 3; --cols-mobile: 2">
              {%- for item in search.results -%}
                <li>
                  {%- case item.object_type -%}
                    {%- when 'product' -%}
                      {%- render 'product-card',
                        card_product: item,
                        index: forloop.index0,
                        sizes: grid_sizes,
                        context: 'search'
                      -%}
                    {%- else -%}
                      <a href="{{ item.url }}" class="text-card" data-reveal>
                        <span class="label label--accent">
                          {%- if item.object_type == 'article' -%}
                            {{ 'search.article' | t }}
                          {%- else -%}
                            {{ 'search.page' | t }}
                          {%- endif -%}
                        </span>
                        <span class="text-card__title">{{ item.title | escape }}</span>
                        <span class="text-card__excerpt text-small text-muted">
                          {{- item.content | strip_html | truncatewords: 24 -}}
                        </span>
                        <span class="link">{{ 'general.read_more' | t }} {% render 'icon', name: 'arrow-right' %}</span>
                      </a>
                  {%- endcase -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <div class="collection__empty">
              <p class="h3">{{ 'search.no_results' | t: terms: terms }}</p>
              <p class="text-muted">{{ 'search.no_results_hint' | t }}</p>
              <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline">
                <span class="btn__label">{{ 'cart.continue' | t }}</span>
              </a>
            </div>
          {%- endif -%}

          {%- render 'paginate-links', paginate: paginate -%}
        </div>

        {%- if s.enable_filtering or s.enable_sorting -%}
          {%- render 'filter-drawer', results: search, section_id: section.id, terms: terms, count: search.results_count -%}
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="search-page__intro">
        <p class="text-muted">{{ 'search.intro' | t }}</p>
      </div>
    {%- endif -%}
  </facet-results>
</section>

{% schema %}
{
  "name": "Sökresultat",
  "class": "section-main-search",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Resultat per sida",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Kolumner på desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Sortering",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Färgschema",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
