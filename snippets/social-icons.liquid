{%- comment -%}
  Ikoner till sociala medier från temainställningarna.
{%- endcomment -%}
{%- liquid
  assign networks = 'instagram,tiktok,facebook,youtube,pinterest,twitter' | split: ','
-%}
<ul class="social" role="list">
  {%- for network in networks -%}
    {%- liquid
      assign key = 'social_' | append: network | append: '_link'
      assign url = settings[key]
      assign icon_name = network
      if network == 'twitter'
        assign icon_name = 'x'
      endif
    -%}
    {%- if url != blank -%}
      <li>
        <a href="{{ url }}" target="_blank" rel="noopener">
          {%- render 'icon', name: icon_name -%}
          <span class="visually-hidden">
            {%- case network -%}
              {%- when 'instagram' -%}
                {{ 'general.social.instagram' | t }}
              {%- when 'tiktok' -%}
                {{ 'general.social.tiktok' | t }}
              {%- when 'facebook' -%}
                {{ 'general.social.facebook' | t }}
              {%- when 'youtube' -%}
                {{ 'general.social.youtube' | t }}
              {%- when 'pinterest' -%}
                {{ 'general.social.pinterest' | t }}
              {%- else -%}
                {{ 'general.social.twitter' | t }}
            {%- endcase -%}
          </span>
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
