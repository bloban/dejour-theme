{%- comment -%}
  Framstegsmätare för fri frakt. Visas bara i butikens valuta.
{%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 0 | times: 100
  assign show_bar = false
  if threshold > 0 and cart.currency.iso_code == shop.currency and cart.item_count > 0
    assign show_bar = true
  endif
-%}
{%- if show_bar -%}
  {%- liquid
    assign remaining = threshold | minus: cart.total_price
    assign progress = cart.total_price | times: 1.0 | divided_by: threshold | at_most: 1
    assign progress_pct = progress | times: 100 | round
    assign remaining_money = remaining | money
  -%}
  <div class="free-ship">
    <p class="free-ship__text">
      {%- if remaining > 0 -%}
        {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'cart.free_shipping_reached' | t }}
      {%- endif -%}
    </p>
    <div
      class="free-ship__bar"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ progress_pct }}"
      aria-label="{{ 'cart.free_shipping_label' | t }}"
    >
      <span style="--progress: {{ progress }}"></span>
    </div>
  </div>
{%- endif -%}
