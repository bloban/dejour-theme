{%- comment -%}
  En rad i varukorgen (används av panelen och varukorgssidan).
  - item: line item
  - index: radnummer (forloop.index)
  - sizes: bildstorlek
{%- endcomment -%}
{%- liquid
  assign image_alt = item.image.alt | default: item.product.title
  assign rule = item.variant.quantity_rule
  assign image_sizes = sizes | default: '88px'
-%}
<li class="cart-line" id="CartLine-{{ index }}">
  <a href="{{ item.url }}" class="cart-line__media media" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{
        item.image
        | image_url: width: 360
        | image_tag: loading: 'lazy', alt: image_alt, widths: '120, 180, 240, 360', sizes: image_sizes
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </a>

  <div class="cart-line__info">
    <div class="cart-line__top">
      <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title | escape }}</a>
      <div class="cart-line__price">
        {%- if item.original_line_price != item.final_line_price -%}
          <s class="price__compare">{{ item.original_line_price | money }}</s><br>
        {%- endif -%}
        {{ item.final_line_price | money }}
      </div>
    </div>

    <div class="cart-line__meta">
      {%- unless item.product.has_only_default_variant -%}
        {%- for option in item.options_with_values -%}
          <div>{{ option.name }}: {{ option.value }}</div>
        {%- endfor -%}
      {%- endunless -%}

      {%- for property in item.properties -%}
        {%- assign first_char = property.first | slice: 0 -%}
        {%- if property.last != blank and first_char != '_' -%}
          <div>
            {{ property.first }}:
            {% if property.last contains '/uploads/' -%}
              <a href="{{ property.last }}" class="text-link" target="_blank" rel="noopener">
                {{- property.last | split: '/' | last -}}
              </a>
            {%- else -%}
              {{ property.last }}
            {%- endif %}
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- if item.selling_plan_allocation -%}
        <div>{{ item.selling_plan_allocation.selling_plan.name }}</div>
      {%- endif -%}

      {%- for discount in item.line_level_discount_allocations -%}
        <div class="cart-totals__discount">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</div>
      {%- endfor -%}
    </div>

    <div class="cart-line__bottom">
      <div class="qty">
        <button type="button" data-qty-btn="minus" aria-label="{{ 'cart.decrease' | t: product: item.product.title | escape }}">
          {%- render 'icon', name: 'minus' -%}
        </button>
        <input
          type="number"
          inputmode="numeric"
          data-cart-qty
          data-line="{{ index }}"
          value="{{ item.quantity }}"
          min="0"
          step="{{ rule.increment | default: 1 }}"
          {% if rule.max != null %}
            max="{{ rule.max }}"
          {% endif %}
          aria-label="{{ 'cart.quantity_for' | t: product: item.product.title | escape }}"
        >
        <button type="button" data-qty-btn="plus" aria-label="{{ 'cart.increase' | t: product: item.product.title | escape }}">
          {%- render 'icon', name: 'plus' -%}
        </button>
      </div>
      <a href="{{ item.url_to_remove }}" class="cart-line__remove" data-cart-remove data-line="{{ index }}">
        {{- 'cart.remove' | t -}}
        <span class="visually-hidden">{{ item.product.title | escape }}</span>
      </a>
    </div>
    <p class="cart-line__error" data-line-error role="alert" hidden></p>
  </div>
</li>
