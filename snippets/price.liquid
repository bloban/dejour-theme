{%- comment -%}
  Pris med jämförpris och jämförpris per enhet.
  - product: produktobjekt (krävs)
  - variant: variant (valfri; annars produktens lägsta pris)
  - class: extra klasser
{%- endcomment -%}
{%- liquid
  if variant != blank
    assign price = variant.price
    assign compare = variant.compare_at_price
    assign varies = false
    assign unit_target = variant
  else
    assign price = product.price
    assign compare = product.compare_at_price
    assign varies = product.price_varies
    assign unit_target = product.selected_or_first_available_variant
  endif

  if settings.currency_code_enabled
    assign price_money = price | money_with_currency
    assign compare_money = compare | money_with_currency
  else
    assign price_money = price | money
    assign compare_money = compare | money
  endif

  assign on_sale = false
  if compare > price
    assign on_sale = true
  endif
-%}
<span class="price{% if on_sale %} price--sale{% endif %}{% if class %} {{ class }}{% endif %}">
  {%- if varies -%}
    <span class="price__from">{{ 'products.from' | t }}</span>
  {%- endif -%}
  <span class="price__current">
    {%- if on_sale -%}<span class="visually-hidden">{{ 'products.sale_price' | t }}</span>{%- endif -%}
    {{ price_money }}
  </span>
  {%- if on_sale -%}
    <s class="price__compare">
      <span class="visually-hidden">{{ 'products.regular_price' | t }}</span>
      {{- compare_money -}}
    </s>
  {%- endif -%}
  {%- if unit_target.unit_price_measurement -%}
    <span class="price__unit">
      {{- unit_target.unit_price | money -}}/
      {%- if unit_target.unit_price_measurement.reference_value != 1 -%}
        {{- unit_target.unit_price_measurement.reference_value -}}
      {%- endif -%}
      {{- unit_target.unit_price_measurement.reference_unit -}}
    </span>
  {%- endif -%}
</span>
