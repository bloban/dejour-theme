{% layout none %}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {% render 'head-meta' %}
    {{ content_for_header }}
    {% render 'head-styles' %}
    {{ 'pages.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="template-gift-card{% if settings.grain_enabled %} has-grain{% endif %}">
    {%- liquid
      if settings.currency_code_enabled
        assign balance = gift_card.balance | money_with_currency
      else
        assign balance = gift_card.balance | money
      endif
    -%}
    <main class="giftcard dj-section color-scheme-5">
      <div class="giftcard__inner">
        <span class="wordmark">{{ settings.wordmark | default: shop.name | escape }}</span>

        <div class="giftcard__card">
          <p class="label label--accent">{{ 'gift_cards.issued.title' | t: value: balance, shop: shop.name }}</p>
          <p class="giftcard__balance gold-text">{{ balance }}</p>
          {%- if gift_card.enabled == false or gift_card.expired -%}
            <span class="badge badge--muted">{{ 'gift_cards.issued.expired' | t }}</span>
          {%- endif -%}
          {%- if gift_card.expires_on -%}
            {%- assign expires = gift_card.expires_on | date: '%Y-%m-%d' -%}
            <p class="text-small text-muted">{{ 'gift_cards.issued.expiration_date' | t: expires_on: expires }}</p>
          {%- endif -%}
        </div>

        <p class="text-body">{{ 'gift_cards.issued.how_to_use_gift_card' | t }}</p>
        <p id="GiftCardCode" class="giftcard__code">{{ gift_card.code | format_code }}</p>
        <div class="giftcard__qr" data-identifier="{{ gift_card.qr_identifier }}"></div>

        <div class="btn-group giftcard__actions">
          <button type="button" class="btn btn--primary" data-copy-code>
            <span class="btn__label">{{ 'gift_cards.issued.copy_code' | t }}</span>
          </button>
          <a href="{{ shop.url }}" class="btn btn--outline">
            <span class="btn__label">{{ 'gift_cards.issued.shop_link' | t }}</span>
          </a>
          {%- if gift_card.pass_url -%}
            <a href="{{ gift_card.pass_url }}">
              <img
                src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                width="120"
                height="40"
                alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}"
                loading="lazy"
              >
            </a>
          {%- endif -%}
        </div>
        <p class="form-msg form-msg--success" role="status" data-copy-success hidden>
          {%- render 'icon', name: 'check' -%}
          <span>{{ 'gift_cards.issued.copy_code_success' | t }}</span>
        </p>
      </div>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var qr = document.querySelector('.giftcard__qr');
        if (qr && window.QRCode) {
          new QRCode(qr, {
            text: qr.dataset.identifier,
            width: 96,
            height: 96,
            imageAltText: {{ 'gift_cards.issued.qr_image_alt' | t | json }},
          });
        }
        var btn = document.querySelector('[data-copy-code]');
        if (btn && navigator.clipboard) {
          btn.addEventListener('click', function () {
            navigator.clipboard.writeText(document.getElementById('GiftCardCode').innerText).then(function () {
              document.querySelector('[data-copy-success]').hidden = false;
            });
          });
        }
      });
    </script>
  </body>
</html>
