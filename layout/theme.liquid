<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_schemes['scheme-1'].settings.background | default: '#0A0A0A' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_heading_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: number: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- comment -%}
      Klassas innan första målning: rörelse, svaga enheter och laddningsskärm.
    {%- endcomment -%}
    <script>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        d.classList.add('js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var n = navigator;
        var c = n.connection || {};
        var lite =
          !!c.saveData ||
          /(^|-)2g$/.test(c.effectiveType || '') ||
          (n.deviceMemory && n.deviceMemory <= 2) ||
          (n.hardwareConcurrency && n.hardwareConcurrency < 4);
        d.classList.add(reduce ? 'reduce-motion' : 'motion-ok');
        if (lite) d.classList.add('is-lite');
        if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) d.classList.add('has-hover');
        {%- if settings.loader_enabled and request.design_mode == false %}
        try {
          if (!reduce && !sessionStorage.getItem('dj-visited')) d.classList.add('show-loader');
        } catch (e) {}
        {%- endif %}
        setTimeout(function () {
          if (!window.DJ || !window.DJ.ready) d.classList.add('reveal-all');
        }, 3500);
      })();
    </script>

    <script type="module">
      import * as StandardEvents from 'https://cdn.shopify.com/storefront/standard-events.js';

      window.StandardEvents = StandardEvents;

      customElements.define('collection-component', StandardEvents.createViewEventElement());
      customElements.define(
        'product-component',
        StandardEvents.createViewEventElement(HTMLElement, { defaultTrigger: 'intersect' })
      );

      document.addEventListener(
        'DOMContentLoaded',
        () => {
          const template = document.querySelector('main[data-template]')?.dataset.template || '';
          document.dispatchEvent(
            new StandardEvents.PageViewEvent({
              page: { template, title: document.title, url: window.location.href },
            })
          );
        },
        { once: true }
      );
    </script>

    {{ content_for_header }}

    {%- liquid
      assign heading_font = settings.type_heading_font
      assign heading_font_italic = heading_font | font_modify: 'style', 'italic'
      assign body_font = settings.type_body_font
      assign body_font_medium = body_font | font_modify: 'weight', '500'
      assign body_font_bold = body_font | font_modify: 'weight', '600'
    -%}

    {% style %}
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ heading_font_italic | font_face: font_display: 'swap' }}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ body_font_medium | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}

      {% for scheme in settings.color_schemes -%}
        {%- if forloop.index == 1 -%}:root,{%- endif %}
        .color-{{ scheme.id }} {
          --c-bg: {{ scheme.settings.background }};
          --c-bg-rgb: {{ scheme.settings.background.rgb | replace: ' ', ',' }};
          --c-bg-image: {% if scheme.settings.background_gradient != blank %}{{ scheme.settings.background_gradient }}{% else %}none{% endif %};
          --c-surface: {{ scheme.settings.surface }};
          --c-text: {{ scheme.settings.text }};
          --c-text-rgb: {{ scheme.settings.text.rgb | replace: ' ', ',' }};
          --c-muted: {{ scheme.settings.muted }};
          --c-accent: {{ scheme.settings.accent }};
          --c-accent-rgb: {{ scheme.settings.accent.rgb | replace: ' ', ',' }};
          --c-accent-light: {{ scheme.settings.accent_light }};
          --c-accent-dark: {{ scheme.settings.accent | color_darken: 18 }};
          --c-on-accent: {{ scheme.settings.on_accent }};
        }
      {% endfor %}

      :root {
        --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-heading-weight: {{ heading_font.weight }};
        --font-heading-style: {{ heading_font.style }};
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-body-weight: {{ body_font.weight }};
        --font-body-weight-medium: {% if body_font_medium %}500{% else %}{{ body_font.weight }}{% endif %};
        --font-body-weight-bold: {% if body_font_bold %}600{% else %}{{ body_font.weight | plus: 200 | at_most: 900 }}{% endif %};
        --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --body-scale: {{ settings.body_scale | divided_by: 100.0 }};
        --heading-tracking: {{ settings.heading_tracking | divided_by: 100.0 }}em;
        --label-tracking: {{ settings.label_tracking | divided_by: 100.0 }}em;
        --page-width: {{ settings.page_width }}px;
        --gutter-desktop: {{ settings.page_gutter }}px;
        --logo-width: {{ settings.logo_width }}px;
        --grain-opacity: {{ settings.grain_opacity | divided_by: 100.0 }};
        --c-error: {{ settings.color_error }};
        --c-success: {{ settings.color_success }};
      }

      {%- if settings.page_transitions %}
        @media (prefers-reduced-motion: no-preference) {
          @view-transition { navigation: auto; }
        }
      {%- endif %}
    {% endstyle %}

    {{ 'dejour.css' | asset_url | stylesheet_tag }}

    {%- unless heading_font.system? -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link rel="preload" as="font" href="{{ heading_font | font_url }}" type="font/woff2" crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endunless -%}
    {%- unless body_font.system? -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link rel="preload" as="font" href="{{ body_font | font_url }}" type="font/woff2" crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endunless -%}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body
    class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}{% if settings.grain_enabled %} has-grain{% endif %}{% if settings.shimmer_enabled %} has-shimmer{% endif %}{% if settings.page_transitions %} has-transitions{% endif %}{% if settings.reveal_enabled == false %} no-reveal{% endif %}"
  >
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {%- if settings.loader_enabled -%}
      {% render 'loader' %}
    {%- endif -%}

    {% sections 'header-group' %}

    <main
      id="MainContent"
      class="site-main"
      role="main"
      tabindex="-1"
      data-template="{{ template.name }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <div id="dj-live" class="visually-hidden" aria-live="polite" role="status"></div>

    <script>
      window.DJ = window.DJ || {};
      window.DJ.config = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          search: {{ routes.search_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          recommendations: {{ routes.product_recommendations_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        designMode: {{ request.design_mode | json }},
        motion: {
          reveal: {{ settings.reveal_enabled | json }},
          gsap: {{ settings.gsap_enabled | json }},
          magnetic: {{ settings.magnetic_buttons | json }},
          script: {{ 'motion.js' | asset_url | json }}
        },
        drop: {
          enabled: {{ settings.drop_enabled | json }},
          date: {{ settings.drop_date | strip | json }},
          time: {{ settings.drop_time | strip | json }},
          liveLabel: {{ settings.drop_live_label | json }}
        },
        strings: {
          addToCart: {{ 'products.add_to_cart' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          unavailable: {{ 'products.unavailable' | t | json }},
          salePrice: {{ 'products.sale_price' | t | json }},
          regularPrice: {{ 'products.regular_price' | t | json }},
          adding: {{ 'products.adding' | t | json }},
          added: {{ 'products.added' | t | json }},
          cartError: {{ 'cart.error' | t | json }},
          cartUpdated: {{ 'cart.updated' | t | json }},
          searchLoading: {{ 'search.loading' | t | json }},
          live: {{ 'drop.live_now' | t | json }},
          days: {{ 'drop.days' | t | json }},
          hours: {{ 'drop.hours' | t | json }},
          minutes: {{ 'drop.minutes' | t | json }},
          seconds: {{ 'drop.seconds' | t | json }}
        }
      };
    </script>
  </body>
</html>
