<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'head-meta' %}

    {{ content_for_header }}

    {% render 'head-styles' %}
  </head>

  <body
    class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}{% if settings.grain_enabled %} has-grain{% endif %}{% if settings.shimmer_enabled %} has-shimmer{% endif %}{% if settings.page_transitions %} has-transitions{% endif %}{% if settings.reveal_enabled == false %} no-reveal{% endif %}"
  >
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {%- if settings.loader_enabled -%}
      {% render 'loader' %}
    {%- endif -%}

    {% sections 'header-group' %}

    <main
      id="MainContent"
      class="site-main"
      role="main"
      tabindex="-1"
      data-template="{{ template.name }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <div id="dj-live" class="visually-hidden" aria-live="polite" role="status"></div>

    {% render 'theme-config' %}
  </body>
</html>
