<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'head-meta' %}

    {{ content_for_header }}

    {% render 'head-styles' %}
  </head>

  <body class="template-password{% if settings.grain_enabled %} has-grain{% endif %}{% if settings.shimmer_enabled %} has-shimmer{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% section 'main-password-header' %}

    <main id="MainContent" class="site-main" role="main" tabindex="-1" data-template="password">
      {{ content_for_layout }}
    </main>

    {% section 'main-password-footer' %}

    <div id="dj-live" class="visually-hidden" aria-live="polite" role="status"></div>

    {% render 'theme-config' %}
  </body>
</html>
